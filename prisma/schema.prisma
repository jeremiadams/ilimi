// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @unique
  email String @unique

  Pathway Pathway[]
  Message Message[]

  paystackCustomerId       String?   @unique @map(name: "paystack_customer_id")
  paystackSubscriptionId   String?   @unique @map(name: "paystack_subscription_id")
  paystackEmailToken       String?   @unique @map(name: "paystack_email_token")
  paystackPriceId          String?   @map(name: "paystack_price_id")
  paystackCurrentPeriodEnd DateTime? @unique @map(name: "paystack_current_period_end")
}

enum PathwayStatus {
  NOT_STARTED
  PENDING
  COMPLETED
}

enum MessageRoles {
  USER
  SYSTEM
  ASSISTANT
}

enum QuestionType {
  MULTIPLE_SELECT
  MULTIPLE_CHOICE
}

model Pathway {
  id            String        @id @default(cuid())
  title         String
  description   String
  difficulty    String
  pathwayStatus PathwayStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())

  Module  Module[]
  Message Message[]
  Quiz    Quiz[]

  User   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Module {
  id          String  @id @default(cuid())
  title       String? @db.Text()
  description String? @db.Text()
  content     String? @db.Text()

  pathwayStatus PathwayStatus @default(NOT_STARTED)

  Section Section[]

  Pathway   Pathway? @relation(fields: [pathwayId], references: [id])
  pathwayId String?
}

model Section {
  id      String  @id @default(cuid())
  title   String? @db.Text()
  content String? @db.Text()

  pathwayStatus PathwayStatus @default(NOT_STARTED)

  Message Message[]

  Module   Module? @relation(fields: [moduleId], references: [id])
  moduleId String?
}

model Message {
  id String @id @default(cuid())

  role    MessageRoles @default(USER)
  content String       @db.Text()

  createdAt DateTime @default(now())

  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  Pathway   Pathway? @relation(fields: [pathwayId], references: [id])
  pathwayId String?
  Section   Section? @relation(fields: [sectionId], references: [id])
  sectionId String?
}

model QuestionOption {
  id          String    @id @default(cuid())
  text        String
  is_correct  Boolean
  is_selected Boolean   @default(false)
  Question    Question? @relation(fields: [questionId], references: [id])
  questionId  String?
}

model Question {
  id String @id @default(cuid())

  type        QuestionType
  question    String
  options     QuestionOption[]
  explanation String
  Quiz        Quiz?            @relation(fields: [quizId], references: [id])
  quizId      String?
}

model Quiz {
  id         String  @id @default(cuid())
  isComplete Boolean @default(false)
  score      Int?

  questions Question[]
  Pathway   Pathway?   @relation(fields: [pathwayId], references: [id])
  pathwayId String?
}
