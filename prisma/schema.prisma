// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @unique
  email String @unique

  Pathway Pathway[]
  Message Message[]

  paystackCustomerId       String?   @unique @map(name: "paystack_customer_id")
  paystackSubscriptionId   String?   @unique @map(name: "paystack_subscription_id")
  paystackEmailToken       String?   @unique @map(name: "paystack_email_token")
  paystackPriceId          String?   @map(name: "paystack_price_id")
  paystackCurrentPeriodEnd DateTime? @unique @map(name: "paystack_current_period_end")
}

enum PathwayStatus {
  NOT_STARTED
  PENDING
  COMPLETED
}

model Pathway {
  id            String        @id @default(cuid())
  title         String
  description   String
  pathwayStatus PathwayStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())

  Module  Module[]
  Message Message[]

  User   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Module {
  id          String  @id @default(cuid())
  title       String? @db.Text()
  description String? @db.Text()
  content     String? @db.Text()

  pathwayStatus PathwayStatus @default(NOT_STARTED)

  Pathway   Pathway? @relation(fields: [pathwayId], references: [id])
  pathwayId String?
}

model Message {
  id   String @id @default(cuid())
  text String @db.Text()

  isUserMessage Boolean

  createdAt DateTime @default(now())

  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  Pathway   Pathway? @relation(fields: [pathwayId], references: [id])
  pathwayId String?
}
